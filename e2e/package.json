{
    "name": "webgis-e2e",
    "private": true,
    "scripts": {
        "test": "playwright test",
        "test:chromium": "playwright test --project=chromium",
        "test:no-webkit": "E2E_NO_WEBKIT=1 playwright test",
        "test:smoke": "E2E_NO_WEBKIT=1 playwright test --project=chromium --retries=0 --grep @smoke",
        "test:sanity": "E2E_NO_WEBKIT=1 playwright test --project=chromium --grep @sanity",
        "test:happy": "E2E_NO_WEBKIT=1 playwright test --project=chromium --grep @happy",
        "test:negative": "E2E_NO_WEBKIT=1 playwright test --project=chromium --grep @negative",
        "test:edge": "E2E_NO_WEBKIT=1 playwright test --project=chromium --grep @edge",
        "test:regression": "playwright test --grep @regression",
        "test:a11y": "E2E_NO_WEBKIT=1 playwright test --project=chromium --grep @a11y",
        "test:responsive": "E2E_NO_WEBKIT=1 playwright test --project=chromium --grep @responsive",
        "test:performance": "E2E_NO_WEBKIT=1 playwright test --project=chromium --grep @performance",
        "test:security": "E2E_NO_WEBKIT=1 playwright test --project=chromium --grep @security",
        "test:resilience": "E2E_NO_WEBKIT=1 playwright test --project=chromium --grep @resilience",
        "test:list": "playwright test --list"
    },
    "devDependencies": {
        "@playwright/test": "^1.50.0"
    }
}
