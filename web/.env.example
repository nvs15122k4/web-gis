APP_NAME="WebGIS Sông Hậu"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Trên Vercel đặt LOG_CHANNEL=stderr (hệ thống file chỉ đọc)
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Một CSDL duy nhất: Supabase Postgres + PostGIS (bảng ứng dụng và bảng không gian cùng kết nối pgsql).
# Supabase > Project Settings > Database > Connection pooling (Transaction, cổng 6543).
# Máy dev có thể trỏ về PostgreSQL/PostGIS cục bộ: host 127.0.0.1, cổng 5432, DB_PGSQL_SSLMODE=prefer.
DB_CONNECTION=pgsql
DB_PGSQL_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PGSQL_PORT=6543
DB_PGSQL_DATABASE=postgres
DB_PGSQL_USERNAME=postgres.your-project-ref
DB_PGSQL_PASSWORD=
DB_PGSQL_SSLMODE=require
# Supabase có thể đặt PostGIS ở schema extensions; liệt kê cả hai để kiểu geometry luôn tìm thấy.
DB_PGSQL_SCHEMA=public,extensions
# Pooler chế độ transaction không hỗ trợ prepared statement phía server -> bắt buộc true (đặt false khi nối thẳng cổng 5432).
DB_PGSQL_EMULATE_PREPARES=true
# Hoặc dán một chuỗi kết nối thay cho các biến DB_PGSQL_* ở trên:
# DB_PGSQL_URL=postgresql://postgres.your-project-ref:MAT_KHAU@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# GeoServer không chạy trên Vercel: khi deploy, trỏ tới GeoServer đã host ở nơi khác (HTTPS).
GEOSERVER_URL=http://localhost:8080/geoserver
GEOSERVER_WORKSPACE=songhau

# Bản đồ nền VIETMAP: đăng ký key tại https://maps.vietmap.vn (để trống = dùng nền dự phòng)
VIETMAP_API_KEY=

# Trên Vercel: SESSION_DRIVER=cookie, CACHE_STORE=array (đã khai trong vercel.json)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
